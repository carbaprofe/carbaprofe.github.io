<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — Carbaprofe</title>
  <link rel="stylesheet" href="/css/estilo.css">
</head>
<body>
  <header>
    <a href="/" class="site-title">Carbaprofe</a>
  </header>
  <main>
    {{ content | safe }}

    {% if backlinks.length > 0 %}
    <nav class="backlinks">
      <h3>Enlazado desde</h3>
      <ul>
        {% for link in backlinks %}
        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {% endfor %}
      </ul>
    </nav>
    {% endif %}
  </main>
</body>
</html>
